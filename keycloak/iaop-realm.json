{
  "realm": "iaop",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "clients": [
    {
      "clientId": "iaop-api",
      "enabled": true,
      "publicClient": false,
      "secret": "local-dev-only-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:8080/*"],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300"
      }
    }
  ],
  "roles": {
    "realm": [
      { "name": "agent", "description": "Insurance agent" },
      { "name": "agency-admin", "description": "Agency administrator" },
      { "name": "ops", "description": "Platform operations" }
    ]
  }
}
